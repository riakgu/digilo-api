app:
  cors:
    allowed-origins:
      - http://localhost:3000
      - http://localhost:3001
  encryption:
    password: "local-dev-password"
    salt: "deadbeef12345678"
  images:
    product-placeholder: ${APP_PRODUCT_PLACEHOLDER_IMAGE:https://placehold.co/600x400?text=No+Image}

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/digilo
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver
    hikari:
      minimum-idle: 2
      maximum-pool-size: 10

  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379
      timeout: 60000ms

jwt:
  access-secret: local-access-secret-key-for-development
  access-expiration: 86400000
  refresh-secret: local-refresh-secret-key-for-development
  refresh-expiration: 604800000
  issuer: digilo

cloudflare:
  r2:
    account-id: your_account_id
    access-key-id: your_key
    secret-access-key: your_secret
    bucket-name: digilo-local
    public-url: https://pub-xxxxx.r2.dev

midtrans:
  server-key: SB-Mid-server-xxxx
  client-key: SB-Mid-client-xxxx
  base-url: https://api.sandbox.midtrans.com
  production: false

logging:
  level:
    org.hibernate.SQL: debug
    org.springframework.security: debug
