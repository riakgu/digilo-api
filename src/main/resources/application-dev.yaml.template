app:
  encryption:
    password: "your-strong-password-here"
    salt: "deadbeef12345678"  # 16 hex chars (8 bytes)

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/digilo
    username: postgres
    password:
    driver-class-name: org.postgresql.Driver
    hikari:
      minimum-idle: 2
      maximum-pool-size: 10

  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379
      timeout: 60000ms

jwt:
  access-secret: dev-access-secret
  access-expiration: 86400000
  refresh-secret: dev-refresh-secret
  refresh-expiration: 604800000
  issuer: digilo

cloudflare:
  r2:
    account-id: your_account_id
    access-key-id: your_key
    secret-access-key: your_secret
    bucket-name: digilo
    public-url: https://pub-xxxxx.r2.dev

midtrans:
  server-key: YOUR_SERVER_KEY
  client-key: YOUR_CLIENT_KEY
  base-url: https://api.sandbox.midtrans.com
  production: false

logging:
  level:
    org.hibernate.SQL: debug
    org.springframework.security: debug
