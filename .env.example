# Spring Profile
# Options: local, dev, staging, prod
SPRING_PROFILES_ACTIVE=local

# Database
POSTGRES_USER=digilo
POSTGRES_PASSWORD=digilo123
POSTGRES_DB=digilo

# Product Placeholder Image URL
APP_PRODUCT_PLACEHOLDER_IMAGE=https://placehold.co/600x400?text=No+Image

# Encryption
APP_ENCRYPTION_PASSWORD=your-strong-password-here
APP_ENCRYPTION_SALT=1234567890abcdef

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx

# R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=digilo
CLOUDFLARE_R2_PUBLIC_URL=

# CORS (comma-separated for multiple origins)
APP_CORS_ALLOWED_ORIGINS=

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# WAHA (WhatsApp)
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=secret
WAHA_SESSION=default

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id